---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
    <main>
      <h1>{SITE_TITLE}</h1>
<p>Software Engineer with 3 years of experience building and maintaining web applications, with a focus on backend and API development. I work mainly with <b>TypeScript</b>, <b>Node.js</b>, and <b>Go</b>, and have experience across the stack: from designing and implementing APIs to contributing to frontend features when needed.</p>
    </main>
		<Footer />
	</body>
</html>
