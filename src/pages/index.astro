---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section>
    <h1>{SITE_TITLE}</h1>
    <p>Software Engineer with 3 years of experience building and maintaining web applications, with a focus on backend and API development. I work mainly with <b>TypeScript</b>, <b>Node.js</b>, and <b>Go</b>, and have experience across the stack: from designing and implementing APIs to contributing to frontend features when needed.</p>
    <ul>
      <li><a href="/projects">Projects</a></li>
      <li>-</li>
      <li><a href="/blog">Blog</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  section {
    width: 720px;
  }

  ul {
    padding: 0;
  }

  ul > li {
    display: inline-block;
  }
</style>

